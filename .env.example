# ---- Server ----
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ---- Supabase (required in production) ----
# Browser auth + cross-device user state (the publishable key is safe to expose;
# row-level security still limits every user to their own data).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only credentials. Never prefix the service-role key with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ---- AI Coach ----
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Free is fixed in server policy at 3/day. Pro is finite and server-configurable.
COACH_PRO_DAILY_LIMIT=100
COACH_XP_REWARD=20

# ---- Dodo Payments (TEST MODE ONLY; all values are server-only) ----
# The official SDK calls the webhook signing secret a webhook key.
DODO_PAYMENTS_API_KEY=dodo_test_REPLACE_ME
DODO_PAYMENTS_WEBHOOK_KEY=whsec_REPLACE_ME
DODO_PAYMENTS_PRODUCT_ID=pdt_REPLACE_ME
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Canonical public origin, no trailing route/query/fragment.
APP_URL=https://datings.lol
# Do not set DODO_PAYMENTS_BASE_URL; the server pins the official test endpoint.

# ---- Security / ops ----
# Comma-separated extra browser origins allowed to call the API. APP_URL is
# auto-added; VERCEL_URL is auto-added on Vercel preview deployments. Leave
# empty for same-origin-only (most secure) when the SPA is served by the
# same server.
CORS_ORIGINS=
# Content-Security-Policy. Defaults ON in production and OFF in development.
# Set to 'false' to opt out in production if you need to debug CSP breakage.
ENABLE_CSP=
# Number of reverse-proxy hops in front of the Express server for correct
# client IPs via X-Forwarded-For. Vercel sets 1; standalone deploys behind
# Cloudflare/nginx may need 2.
TRUST_PROXY_HOPS=1
# Emergency admin access without the admin_users table (comma-separated user ids).
ADMIN_USER_IDS=

# ---- Local dev only ----
# In-memory data, no database needed. NEVER enable in production.
ALLOW_DEMO_MODE=false