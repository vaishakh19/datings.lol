# ---- Server ----
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ---- Supabase (required in production) ----
# Browser auth + cross-device user state (the publishable key is safe to expose;
# row-level security still limits every user to their own data).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only credentials. Never prefix the service-role key with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ---- AI Coach ----
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
COACH_FREE_DAILY_LIMIT=3
COACH_XP_REWARD=20

# ---- Security / ops ----
# Comma-separated extra browser origins allowed to call the API (leave empty
# when the SPA is served by this same server = same-origin, most secure).
CORS_ORIGINS=
# Enable a strict Content-Security-Policy once you've verified the SPA works with it.
ENABLE_CSP=false
# Emergency admin access without the admin_users table (comma-separated user ids).
ADMIN_USER_IDS=

# ---- Local dev only ----
# In-memory data, no database needed. NEVER enable in production.
ALLOW_DEMO_MODE=false